{
  "openapi": "3.1.0",
  "info": {
    "title": "HuskyHealth personal API",
    "version": "1.1.0",
    "description": "A zero-knowledge REST API for your own watch workouts: Apple Watch, and Garmin through Garmin Connect's Apple Health sync. Devices POST records with a write token; the server seals each record to your account's RSA public key on arrival and stores only ciphertext. Reading returns that ciphertext: only the private key in your password-encrypted vault opens it, in your browser or the CLI. The server cannot read your records, your username or your password. Records are a short-lived queue: your client deletes them once they are folded into your encrypted vault, and any record nobody collects is deleted after 30 days. Stored receive times are rounded to the hour; the exact time is sealed inside the record. Errors are always JSON {error, status}; 429 responses carry Retry-After. Every response carries API-Version (now 1.1: records may also carry vo2 and sleep; additive, so /v1/ clients keep working). Limits: 10 log-in attempts per account per 15 minutes; 120 records per device token per hour (300 per account); 120 session requests per minute; per-client request and connection limits at the gateway. Device tokens are write-only and expire (1-365 days, default 90). Request bodies must be application/json (else 415)."
  },
  "servers": [
    {
      "url": "https://veds-pi5.polecat-nominal.ts.net:10000"
    }
  ],
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Write-only device token (hhw_...). Make one on the account page or with POST /v1/account/tokens."
      },
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "1-hour session from POST /v1/account/open (the browser or CLI derives the auth key from your password)."
      }
    },
    "schemas": {
      "Sample": {
        "type": "object",
        "required": [
          "t_s",
          "v"
        ],
        "additionalProperties": false,
        "properties": {
          "t_s": {
            "type": "integer",
            "minimum": 0,
            "description": "seconds before sending"
          },
          "v": {
            "type": "number"
          }
        }
      },
      "Workout": {
        "type": "object",
        "required": [
          "sport",
          "start_s",
          "end_s"
        ],
        "additionalProperties": false,
        "properties": {
          "sport": {
            "enum": [
              "squash",
              "running",
              "walking",
              "cycling",
              "strength",
              "hiit",
              "other"
            ]
          },
          "start_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5270400,
            "description": "seconds before sending (up to 61 days)"
          },
          "end_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5270400
          },
          "kcal": {
            "type": [
              "number",
              "null"
            ]
          },
          "src": {
            "enum": [
              "watch",
              "garmin",
              "other"
            ]
          },
          "hr": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "maxItems": 4000
          }
        }
      },
      "Record": {
        "type": "object",
        "required": [
          "v"
        ],
        "additionalProperties": false,
        "description": "One batch of health data. No names, places, GPS or device names are accepted.",
        "properties": {
          "v": {
            "const": 1
          },
          "workouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workout"
            },
            "maxItems": 20
          },
          "rhr": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "description": "resting heart rate"
          },
          "hrv": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "description": "HRV SDNN, ms"
          },
          "effort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "description": "Watch effort rating 1-10"
          },
          "vo2": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "description": "VO2 max estimates, ml/kg/min"
          },
          "sleep": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "description": "minutes asleep per night; t_s is when you woke"
          }
        }
      },
      "Sealed": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "at": {
            "type": "integer",
            "description": "unix seconds received"
          },
          "key": {
            "type": "string",
            "description": "AES-256 key wrapped with RSA-OAEP(SHA-256)"
          },
          "nonce": {
            "type": "string"
          },
          "ct": {
            "type": "string",
            "description": "AES-256-GCM ciphertext of the Record"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/me/records": {
      "post": {
        "summary": "Add a record",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Record"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored, encrypted. Returns { id, at }."
          },
          "401": {
            "description": "Bad token"
          },
          "409": {
            "description": "Account has no key yet: log in on the website once"
          },
          "422": {
            "description": "Not a valid record (never echoed)"
          },
          "429": {
            "description": "Slow down; see Retry-After (seconds)"
          },
          "415": {
            "description": "Body is not application/json"
          }
        }
      },
      "get": {
        "summary": "List your records (ciphertext). Each opens to { received, record }.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "only records with id > after"
          }
        ],
        "responses": {
          "200": {
            "description": "{ records: Sealed[], last }",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "records": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Sealed"
                      }
                    },
                    "last": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Slow down; see Retry-After (seconds)"
          }
        }
      },
      "delete": {
        "summary": "Delete records up to an id (delete-after-sync)",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "upto",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Needs a session (device tokens cannot delete)"
          },
          "429": {
            "description": "Slow down; see Retry-After (seconds)"
          }
        }
      }
    },
    "/v1/account/tokens": {
      "post": {
        "summary": "New device write token (shown once)",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "201": {
            "description": "{ id, token, scope, expires }"
          },
          "409": {
            "description": "ten tokens already"
          },
          "429": {
            "description": "Slow down; see Retry-After (seconds)"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scope": {
                    "const": "write"
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 365,
                    "default": 90
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List device tokens (ids only)",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ tokens: [{ id, scope, created, expires, last_used }] }"
          },
          "429": {
            "description": "Slow down; see Retry-After (seconds)"
          }
        }
      }
    },
    "/v1/account/tokens/{id}": {
      "delete": {
        "summary": "Revoke a device token",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "429": {
            "description": "Slow down; see Retry-After (seconds)"
          }
        }
      }
    },
    "/v1/account/open": {
      "post": {
        "summary": "Log in with the derived auth key",
        "description": "id = SHA-256('huskyhealth:' + username); auth = bytes 32-64 of PBKDF2-SHA256(password, 'huskyhealth-v1:' + username, 600000, 64). The password never leaves the client.",
        "responses": {
          "200": {
            "description": "{ session, vault (ciphertext), has_pub }"
          },
          "401": {
            "description": "Wrong username or password"
          },
          "429": {
            "description": "Slow down; see Retry-After (seconds)"
          }
        }
      }
    },
    "/v1/speak": {
      "post": {
        "summary": "Speak a short brief (Gradium TTS). Plain brief text only, at most 600 characters.",
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 600
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ audio (base64 WAV), mime, words: [{ text, start_s, stop_s }] }"
          },
          "422": {
            "description": "Not plain brief text"
          },
          "429": {
            "description": "Slow down; see Retry-After"
          },
          "503": {
            "description": "Speech not set up"
          }
        }
      }
    },
    "/v1/listen": {
      "post": {
        "summary": "Talk to your API: a spoken question (WAV, at most 5 s) becomes text (Gradium STT). Never stored.",
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "content": {
            "audio/wav": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ text }"
          },
          "413": {
            "description": "Longer than 5 s"
          },
          "415": {
            "description": "Not audio/wav"
          },
          "429": {
            "description": "Slow down; see Retry-After"
          },
          "503": {
            "description": "Speech not set up"
          }
        }
      }
    }
  }
}
